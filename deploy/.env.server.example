# =============================================================================
# Template .env produksi untuk rest-api di /opt/docker-server-rsi
# Salin nilai yang relevan ke: www/pendaftaran-online/rest-api/.env
# JANGAN commit file .env asli. Kredensial DB tiru dari antrian-bpjs/.env.
# =============================================================================

APP_NAME=Pendaftaran Online
APP_ENV=production
APP_KEY=                  # diisi by: php artisan key:generate
APP_DEBUG=false
APP_URL=http://IP_PUBLIK:PORT/pendaftaran-online/rest-api/public

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=mysql             # nama service di network webserver_webnet
DB_PORT=3306
DB_DATABASE=rsi_jombang
DB_USERNAME=              # samakan dengan antrian-bpjs/.env
DB_PASSWORD=              # samakan dengan antrian-bpjs/.env

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# WA gateway — WAJIB sama persis dengan www/pendaftaran-online/wa-blas/.env
WA_GATEWAY_URL=http://wa-blas:3001
WA_API_KEY=               # openssl rand -base64 32 (bukan "changeme")
WA_ENABLED=true